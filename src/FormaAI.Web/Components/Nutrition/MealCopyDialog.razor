@using FormaAI.Contracts.Nutrition
@inject NutritionClient NutritionApi
@inject ISnackbar Snackbar

@if (Open)
{
    <div class="meal-copy-backdrop" @onclick="Close">
        <section class="meal-copy-dialog" role="dialog" aria-modal="true" aria-labelledby="meal-copy-title" @onclick:stopPropagation="true">
            <header>
                <div><span class="card-kicker">Kopiowanie bez usuwania źródła</span><h2 id="meal-copy-title">@(Step == 1 ? "Wybierz posiłek" : "Wybierz miejsce docelowe")</h2></div>
                <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="Close" aria-label="Zamknij kopiowanie" />
            </header>

            <div class="meal-copy-steps" aria-label="Etapy kopiowania">
                <span class="active">1 · Źródło</span><span class="@(Step == 2 ? "active" : null)">2 · Cel</span>
            </div>

            @if (Step == 1)
            {
                <MudDatePicker Date="_sourceDate" DateChanged="SourceDateChanged" Label="Data źródłowa" MaxDate="DateTime.Today.AddYears(1)" />
                @if (_loading)
                {
                    <PageSkeleton Message="Wczytuję posiłki" Compact="true" />
                }
                else if (_sourceMeals.Count == 0)
                {
                    <div class="module-empty"><MudIcon Icon="@Icons.Material.Outlined.NoMeals" /><div><strong>Brak posiłków tego dnia</strong><span>Wybierz inną datę.</span></div></div>
                }
                else
                {
                    <div class="meal-copy-source-list">
                        @foreach (var meal in _sourceMeals)
                        {
                            <button type="button" class="@(_sourceMealId == meal.Id ? "selected" : null)" @onclick="() => _sourceMealId = meal.Id">
                                <span><strong>@meal.Name</strong><small>@meal.Macro.CaloriesKcal.ToString("0") kcal · @meal.Items.Count składników</small></span>
                                <MudIcon Icon="@(_sourceMealId == meal.Id ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" />
                            </button>
                        }
                    </div>
                }
                <footer><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_sourceMealId is null)" OnClick="() => Step = 2">Dalej</MudButton></footer>
            }
            else
            {
                <div class="meal-copy-source-summary"><span>Kopiujesz</span><strong>@SelectedSource?.Name</strong><small>Oryginał pozostanie w dzienniku.</small></div>
                <MudDatePicker @bind-Date="_targetDate" Label="Data docelowa" />
                <fieldset class="meal-copy-slots">
                    <legend>Sekcja docelowa</legend>
                    @foreach (var slot in MealSlots)
                    {
                        <button type="button" class="@(_targetSlot == slot ? "selected" : null)" @onclick="() => _targetSlot = slot">
                            <span>@slot</span><MudIcon Icon="@(_targetSlot == slot ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" />
                        </button>
                    }
                </fieldset>
                <footer>
                    <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="() => Step = 1">Wstecz</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_saving || _targetDate is null || string.IsNullOrWhiteSpace(_targetSlot))" OnClick="Copy">
                        @(_saving ? "Kopiuję…" : "Kopiuj posiłek")
                    </MudButton>
                </footer>
            }
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public MealResponse? InitialSource { get; set; }
    [Parameter] public DateOnly InitialSourceDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public IReadOnlyList<string> MealSlots { get; set; } = [];
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<MealResponse> Copied { get; set; }

    private bool _wasOpen;
    private bool _loading;
    private bool _saving;
    private int Step { get; set; } = 1;
    private DateTime? _sourceDate;
    private DateTime? _targetDate;
    private Guid? _sourceMealId;
    private string? _targetSlot;
    private Guid _operationId;
    private IReadOnlyList<MealResponse> _sourceMeals = [];
    private MealResponse? SelectedSource => _sourceMeals.FirstOrDefault(x => x.Id == _sourceMealId);

    protected override async Task OnParametersSetAsync()
    {
        if (!Open || _wasOpen)
        {
            _wasOpen = Open;
            return;
        }
        _wasOpen = true;
        Step = InitialSource is null ? 1 : 2;
        _sourceDate = InitialSourceDate.ToDateTime(TimeOnly.MinValue);
        _targetDate = DateTime.Today;
        _targetSlot = MealSlots.FirstOrDefault();
        _operationId = Guid.NewGuid();
        await LoadSource();
        if (InitialSource is not null)
        {
            if (_sourceMeals.All(x => x.Id != InitialSource.Id))
                _sourceMeals = [InitialSource, .. _sourceMeals];
            _sourceMealId = InitialSource.Id;
        }
    }

    private async Task SourceDateChanged(DateTime? value)
    {
        _sourceDate = value;
        await LoadSource();
    }

    private async Task LoadSource()
    {
        if (_sourceDate is null) return;
        _loading = true;
        try
        {
            var date = DateOnly.FromDateTime(_sourceDate.Value);
            _sourceMeals = (await NutritionApi.GetDay(date)).Meals;
            _sourceMealId = _sourceMeals.FirstOrDefault()?.Id;
        }
        catch (HttpRequestException) { Snackbar.Add("Nie udało się pobrać posiłków z wybranego dnia.", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task Copy()
    {
        if (_sourceMealId is not Guid sourceId || _targetDate is null || string.IsNullOrWhiteSpace(_targetSlot)) return;
        _saving = true;
        try
        {
            var copied = await NutritionApi.CopyMeal(
                sourceId,
                new CopyMealRequest(DateOnly.FromDateTime(_targetDate.Value), _targetSlot, _operationId));
            await Copied.InvokeAsync(copied);
            await Close();
        }
        catch (HttpRequestException) { Snackbar.Add("Nie udało się skopiować posiłku. Możesz bezpiecznie spróbować ponownie.", Severity.Error); }
        finally { _saving = false; }
    }

    private async Task Close()
    {
        _wasOpen = false;
        await Closed.InvokeAsync();
    }
}
