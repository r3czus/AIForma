@inject IJSRuntime JS

<div class="exercise-media-frame @(Compact ? "compact" : "full") @Class"
     aria-label="@(!string.IsNullOrWhiteSpace(Alt) ? Alt : null)">
    @if (Exercise?.MediaUrl is null)
    {
        <div class="exercise-media-frame-placeholder">
            <MudIcon Icon="@Icons.Material.Outlined.SportsGymnastics" />
            @if (!Compact)
            {
                <span>Podgląd ruchu nie został jeszcze dodany</span>
            }
        </div>
    }
    else if (IsVideo)
    {
        <video @ref="_video"
               src="@Exercise.MediaUrl"
               muted
               playsinline
               loop="@AllowPlayback"
               preload="metadata"
               tabindex="-1"
               aria-label="@Alt"></video>
        @if (AllowPlayback)
        {
            <button type="button"
                    class="exercise-media-playback"
                    aria-pressed="@_isPlaying"
                    aria-label="@(_isPlaying ? "Wstrzymaj film" : "Odtwórz film")"
                    @onpointerdown:stopPropagation="true"
                    @onpointerup:stopPropagation="true"
                    @onclick:stopPropagation="true"
                    @onclick="TogglePlayback">
                <MudIcon Icon="@(_isPlaying ? Icons.Material.Outlined.Pause : Icons.Material.Outlined.PlayArrow)" />
                <span>@(_isPlaying ? "Pauza" : "Odtwórz")</span>
            </button>
        }
    }
    else if (IsGif && AllowPlayback)
    {
        @if (_isPlaying)
        {
            <img src="@Exercise.MediaUrl"
                 alt="@Alt"
                 loading="eager" />
        }
        else
        {
            <div class="exercise-media-frame-placeholder">
                <MudIcon Icon="@Icons.Material.Outlined.GifBox" />
                <span>Animacja GIF jest wstrzymana</span>
            </div>
        }
        <button type="button"
                class="exercise-media-playback"
                aria-pressed="@_isPlaying"
                aria-label="@(_isPlaying ? "Wstrzymaj animację GIF" : "Odtwórz animację GIF")"
                @onpointerdown:stopPropagation="true"
                @onpointerup:stopPropagation="true"
                @onclick:stopPropagation="true"
                @onclick="TogglePlayback">
            <MudIcon Icon="@(_isPlaying ? Icons.Material.Outlined.Pause : Icons.Material.Outlined.PlayArrow)" />
            <span>@(_isPlaying ? "Pauza" : "Odtwórz")</span>
        </button>
    }
    else if (IsGif)
    {
        <div class="exercise-media-frame-placeholder compact-gif">
            <MudIcon Icon="@Icons.Material.Outlined.GifBox" />
            <span>GIF</span>
        </div>
    }
    else
    {
        <img src="@Exercise.MediaUrl"
             alt="@Alt"
             loading="@(Compact ? "lazy" : "eager")" />
    }
</div>

@code {
    [Parameter, EditorRequired] public ExerciseResponse? Exercise { get; set; }
    [Parameter] public string Alt { get; set; } = string.Empty;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool AllowPlayback { get; set; }
    [Parameter] public string? Class { get; set; }

    private ElementReference _video;
    private string? _mediaKey;
    private bool _motionInitialized;
    private bool _isPlaying;
    private bool IsGif => string.Equals(Exercise?.MediaContentType, "image/gif", StringComparison.OrdinalIgnoreCase);
    private bool IsVideo => Exercise?.MediaContentType?.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true;

    protected override void OnParametersSet()
    {
        var mediaKey = $"{Exercise?.MediaUrl}|{Exercise?.MediaContentType}|{AllowPlayback}";
        if (string.Equals(mediaKey, _mediaKey, StringComparison.Ordinal))
            return;

        _mediaKey = mediaKey;
        _motionInitialized = false;
        _isPlaying = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_motionInitialized || !AllowPlayback || (!IsGif && !IsVideo))
            return;

        _motionInitialized = true;
        try
        {
            _isPlaying = await JS.InvokeAsync<bool>("formaMotion.allowsMotion");
            if (IsVideo)
                await JS.InvokeVoidAsync("formaMotion.setMediaPlayback", _video, _isPlaying);
        }
        catch (JSException)
        {
            _isPlaying = false;
        }

        StateHasChanged();
    }

    private async Task TogglePlayback()
    {
        _isPlaying = !_isPlaying;
        if (!IsVideo)
            return;

        try
        {
            await JS.InvokeVoidAsync("formaMotion.setMediaPlayback", _video, _isPlaying);
        }
        catch (JSException)
        {
            _isPlaying = false;
        }
    }
}
