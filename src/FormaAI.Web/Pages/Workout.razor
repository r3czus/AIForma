@page "/workout/{Id:guid}"
@implements IAsyncDisposable
@using FormaAI.Application.Training
@inject TrainingClient TrainingApi
@inject NutritionClient NutritionApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Aktywny trening · FormaAI</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="content-wrap workout-mode">
    @if (_session is null)
    {
        <PageSkeleton Message="Przygotowuję sesję" Compact="true" />
    }
    else
    {
        <header class="workout-heading">
            <MudIconButton Href="/training" Icon="@Icons.Material.Filled.ArrowBack" Class="workout-back" aria-label="Wróć do planu" />
            <div>
                <span class="page-kicker">Sesja na żywo</span>
                <MudText Typo="Typo.h4">@_session.Name</MudText>
            </div>
            <span class="data-chip">@CompletedSets / @PlannedSets serii</span>
        </header>

        @if (_session.CardioEntries is { Count: > 0 })
        {
            <section class="workout-cardio-summary">
                <span class="card-kicker">Cardio w tej sesji</span>
                @foreach (var cardio in _session.CardioEntries)
                {
                    <div>
                        <MudIcon Icon="@Icons.Material.Outlined.DirectionsRun" />
                        <strong>@cardio.ActivityName</strong>
                        <span>@cardio.DurationMinutes min@if (cardio.DistanceKm is not null) { <text> · @cardio.DistanceKm.GetValueOrDefault().ToString("0.##") km</text> }</span>
                    </div>
                }
            </section>
        }

        @if (_completed)
        {
            <section class="workout-finish-summary">
                <div class="finish-title">
                    <div><span class="page-kicker">Trening zakończony</span><MudText Typo="Typo.h3">Sesja zapisana</MudText><p>@CompletionCopy</p></div>
                    <span class="finish-score">@SessionPercent%</span>
                </div>

                <div class="metric-row workout-summary-metrics">
                    <div><span>Czas</span><strong>@FormatElapsed(_elapsed)</strong></div>
                    <div><span>Serie robocze</span><strong>@WorkingSets</strong></div>
                    <div><span>Objętość</span><strong>@SessionVolume.ToString("0") kg</strong></div>
                    <div><span>Powtórzenia</span><strong>@TotalRepetitions</strong></div>
                </div>
                @if (_trainingCalories > 0)
                {
                    <div class="workout-calorie-result"><MudIcon Icon="@Icons.Material.Outlined.LocalFireDepartment" /><span>Dodatkowe kalorie na dziś</span><strong>+@_trainingCalories.ToString("0") kcal</strong></div>
                }

                @if (_newRecords.Count > 0)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">Nowy najlepszy wynik: @string.Join(", ", _newRecords)</MudAlert>
                }

                @if (_progressions.Count > 0)
                {
                    <section class="progression-review">
                        <div><span class="card-kicker">Następna sesja</span><MudText Typo="Typo.h6">Progres wymaga Twojej decyzji</MudText></div>
                        @foreach (var item in _progressions)
                        {
                            <article><div><strong>@item.ExerciseName</strong><span>@item.Reason</span></div><div class="progression-values"><strong>@item.SuggestedWeightKg.ToString("0.#") kg</strong><span>· @item.MinReps-@item.MaxReps powt.</span></div>@if (item.Decision == ProgressionDecision.Pending) { <div class="progression-actions"><MudButton Size="Size.Small" Color="Color.Success" OnClick="() => Decide(item, ProgressionDecision.Accepted)">Akceptuj</MudButton><MudButton Size="Size.Small" OnClick="() => Decide(item, ProgressionDecision.Changed)">Bez zmiany</MudButton><MudButton Size="Size.Small" Color="Color.Error" OnClick="() => Decide(item, ProgressionDecision.Rejected)">Odrzuć</MudButton></div> } else { <MudChip T="string" Size="Size.Small">@DecisionName(item.Decision)</MudChip> }</article>
                        }
                    </section>
                }

                <div class="workout-result-list">
                    @foreach (var exercise in OrderedExercises)
                    {
                        <article>
                            <div><strong>@exercise.ExerciseName</strong><span>@exercise.Sets.Count z @exercise.PlannedSets serii · @ExerciseVolume(exercise).ToString("0") kg objętości</span></div>
                            <span>e1RM <strong>@BestEstimatedOneRepMax(exercise).ToString("0.#") kg</strong></span>
                        </article>
                    }
                </div>

                <div class="finish-actions">
                    <MudButton Href="/progress" Variant="Variant.Outlined" FullWidth="true">Zobacz progres</MudButton>
                    <MudButton Href="/training" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Wróć do treningów</MudButton>
                </div>
            </section>
        }
        else if (ActiveExercise is { } exercise)
        {
            var form = _forms[exercise.Id];

            <section class="workout-console" aria-label="Czas i postęp treningu">
                <div class="session-clock"><span>Czas treningu</span><strong>@FormatElapsed(_elapsed)</strong><small>start @_session.StartedAtUtc.ToLocalTime().ToString("HH:mm")</small></div>
                <div class="session-progress"><span>Postęp sesji</span><strong>@SessionPercent%</strong><i style="@($"--progress: {SessionPercent}%")"><b></b></i></div>
            </section>

            <nav class="exercise-switcher" aria-label="Ćwiczenia w sesji">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(_activeExerciseIndex == 0)" OnClick="PreviousExercise" aria-label="Poprzednie ćwiczenie" />
                <div>
                    @for (var index = 0; index < OrderedExercises.Count; index++)
                    {
                        var navIndex = index;
                        var item = OrderedExercises[index];
                        <button type="button" class="@(index == _activeExerciseIndex ? "active" : null) @(item.Sets.Count >= item.PlannedSets ? "done" : null)" @onclick="() => SelectExercise(navIndex)" aria-label="@item.ExerciseName" aria-current="@(index == _activeExerciseIndex ? "step" : null)" title="@item.ExerciseName"><span></span></button>
                    }
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(_activeExerciseIndex >= OrderedExercises.Count - 1)" OnClick="NextExercise" aria-label="Następne ćwiczenie" />
            </nav>

            @if (_timerMode != TimerMode.None)
            {
                <section class="workout-timer @(_timerMode == TimerMode.Interval ? "interval" : null)" aria-live="polite">
                    <div><span>@TimerLabel</span><strong>@FormatTime(_timerSeconds)</strong></div>
                    <MudIconButton Icon="@(_timerRunning ? Icons.Material.Outlined.Pause : Icons.Material.Outlined.PlayArrow)" OnClick="ToggleTimer" aria-label="@(_timerRunning ? "Wstrzymaj timer" : "Wznów timer")" />
                    <MudIconButton Icon="@Icons.Material.Outlined.RestartAlt" OnClick="ResetTimer" aria-label="Resetuj timer" />
                    <MudButton Variant="Variant.Text" OnClick="CloseTimer">Zamknij</MudButton>
                </section>
            }

            <article class="workout-exercise workout-exercise-focus">
                <ExerciseMediaFrame Exercise="ActiveExerciseMedia"
                                    Alt="@($"Podgląd wykonania: {exercise.ExerciseName}")"
                                    AllowPlayback="true"
                                    Class="workout-motion-hero" />
                <div class="exercise-live-heading">
                    <span class="exercise-order">@(_activeExerciseIndex + 1)</span>
                    <div>
                        <span class="card-kicker">Ćwiczenie @(_activeExerciseIndex + 1) z @OrderedExercises.Count</span>
                        <MudText Typo="Typo.h4">@exercise.ExerciseName</MudText>
                        <MudText Typo="Typo.caption">@exercise.PlannedSets × @exercise.MinReps-@exercise.MaxReps @if (exercise.TargetRir is not null) { <span>· RIR @exercise.TargetRir</span> }</MudText>
                        @if (exercise.Presets is { Count: > 0 })
                        {
                            <span class="ai-preset-badge"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /> Serie przygotowane przez AI</span>
                        }
                    </div>
                    <strong class="exercise-set-count">@exercise.Sets.Count/@exercise.PlannedSets</strong>
                </div>

                <div class="exercise-live-actions">
                    <MudButton Class="swap-exercise-trigger" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.SwapHoriz"
                               OnClick="() => BeginSwap(exercise)">Zamień ćwiczenie</MudButton>
                    <MudButton Class="superset-builder-trigger" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Layers"
                               OnClick="() => BeginSuperset(exercise)">Połącz w superserię</MudButton>
                </div>
                @if (_swapTargetId == exercise.Id)
                {
                    <div class="workout-sheet-backdrop" @onclick="CancelSwap">
                        <section class="workout-sheet swap-sheet"
                                 role="dialog"
                                 aria-modal="true"
                                 aria-labelledby="swap-sheet-title"
                                 tabindex="-1"
                                 @onkeydown="HandleSwapKeyDown"
                                 @onclick:stopPropagation="true">
                            <header class="workout-sheet-header">
                                <div>
                                    <span class="card-kicker">Aktualne ćwiczenie</span>
                                    <h2 id="swap-sheet-title">Zamień ćwiczenie</h2>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                               OnClick="CancelSwap"
                                               aria-label="Zamknij wybór zamiennika" />
                            </header>

                            <section class="swap-current-exercise">
                                <ExerciseMediaFrame Exercise="ActiveExerciseMedia"
                                                    Alt=""
                                                    Compact="true" />
                                <div>
                                    <strong>@exercise.ExerciseName</strong>
                                    <span>@exercise.PlannedSets serie × @exercise.MinReps-@exercise.MaxReps powt.</span>
                                    <small>@(exercise.Sets.Count == 0 ? "Zamiana przed pierwszą serią" : $"Wykonane serie zostaną zachowane: {exercise.Sets.Count}")</small>
                                </div>
                            </section>

                            <MudTextField @bind-Value="_swapSearch"
                                          Immediate="true"
                                          Label="Znajdź zamiennik"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Outlined.Search"
                                          Class="swap-search" />

                            <div class="swap-filter" aria-label="Filtry zamienników">
                                <MudSelect T="MuscleGroup?" @bind-Value="_swapMuscleGroup" Label="Partia">
                                    <MudSelectItem T="MuscleGroup?" Value="@((MuscleGroup?)null)">Wszystkie</MudSelectItem>
                                    @foreach (var group in Enum.GetValues<MuscleGroup>())
                                    {
                                        <MudSelectItem T="MuscleGroup?" Value="@((MuscleGroup?)group)">@MuscleGroupName(group)</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="Equipment?" @bind-Value="_swapEquipment" Label="Sprzęt">
                                    <MudSelectItem T="Equipment?" Value="@((Equipment?)null)">Dowolny</MudSelectItem>
                                    @foreach (var equipment in Enum.GetValues<Equipment>())
                                    {
                                        <MudSelectItem T="Equipment?" Value="@((Equipment?)equipment)">@EquipmentName(equipment)</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudCheckBox @bind-Value="_swapSimilarOnly" Label="Podobne" Color="Color.Primary" />
                            </div>

                            <div class="swap-exercise-results">
                                @foreach (var option in SwapOptions)
                                {
                                    var selected = _selectedExerciseId == option.Id;
                                    <button type="button"
                                            class="swap-result @(selected ? "selected" : null)"
                                            aria-pressed="@selected"
                                            @onclick="() => _selectedExerciseId = option.Id">
                                        <ExerciseMediaFrame Exercise="option" Alt="" Compact="true" />
                                        <span>
                                            <strong>@option.Name</strong>
                                            <small>@MuscleGroupName(option.MuscleGroup) · @EquipmentName(option.Equipment)</small>
                                        </span>
                                        <MudIcon Icon="@(selected ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" />
                                    </button>
                                }
                                @if (SwapOptions.Count == 0)
                                {
                                    <div class="swap-empty-state">
                                        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" />
                                        <strong>Brak pasujących zamienników</strong>
                                        <span>Wyczyść filtr partii lub sprzętu i spróbuj ponownie.</span>
                                    </div>
                                }
                            </div>

                            <footer class="swap-exercise-actions">
                                <span>@SwapExplanation(exercise)</span>
                                <div>
                                    <MudButton Variant="Variant.Outlined" Disabled="_swapping" OnClick="CancelSwap">Anuluj</MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Disabled="@(_selectedExerciseId is null || _swapping)"
                                               OnClick="() => ReplaceExercise(exercise)">
                                        @(_swapping ? "Zamieniam…" : "Potwierdź zamianę")
                                    </MudButton>
                                </div>
                            </footer>
                        </section>
                    </div>
                }

                @if (_supersetBuilderOpen)
                {
                    <section class="superset-builder" aria-label="Utwórz superserię">
                        <header>
                            <div><span class="card-kicker">Superseria</span><strong>Wybierz ćwiczenia wykonywane po sobie</strong></div>
                            <MudIconButton Icon="@Icons.Material.Outlined.Close" OnClick="CancelSuperset" aria-label="Zamknij wybór superserii" />
                        </header>
                        <div class="superset-builder-list">
                            @foreach (var selectedExerciseId in _supersetExerciseIds)
                            {
                                var item = OrderedExercises.First(x => x.Id == selectedExerciseId);
                                var selectedIndex = _supersetExerciseIds.IndexOf(selectedExerciseId);
                                <div class="superset-builder-row">
                                    <button type="button" class="selected" aria-pressed="true"
                                            @onclick="() => ToggleSupersetExercise(item.Id)">
                                        <span>@(selectedIndex + 1)</span>
                                        <strong>@item.ExerciseName</strong>
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                                    </button>
                                    <div class="superset-order-actions" aria-label="@($"Kolejność: {item.ExerciseName}")">
                                        <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp"
                                                       Disabled="@(selectedIndex == 0)"
                                                       OnClick="() => MoveSupersetExercise(item.Id, -1)"
                                                       aria-label="Przesuń wyżej" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown"
                                                       Disabled="@(selectedIndex == _supersetExerciseIds.Count - 1)"
                                                       OnClick="() => MoveSupersetExercise(item.Id, 1)"
                                                       aria-label="Przesuń niżej" />
                                    </div>
                                </div>
                            }
                            @foreach (var item in OrderedExercises.Where(x => !_supersetExerciseIds.Contains(x.Id)))
                            {
                                <button type="button" aria-pressed="false"
                                        disabled="@(_supersetExerciseIds.Count >= 5)"
                                        @onclick="() => ToggleSupersetExercise(item.Id)">
                                    <span>+</span>
                                    <strong>@item.ExerciseName</strong>
                                    <MudIcon Icon="@Icons.Material.Outlined.RadioButtonUnchecked" />
                                </button>
                            }
                        </div>
                        <div class="superset-builder-timing">
                            <MudNumericField @bind-Value="_supersetRounds" Label="Liczba rund" Min="@MinimumSupersetRounds" Max="10" HideSpinButtons="true" />
                            <MudNumericField @bind-Value="_supersetIntervalSeconds" Label="Między ćwiczeniami (s)" Min="0" Max="3600" HideSpinButtons="true" />
                            <MudNumericField @bind-Value="_supersetRestSeconds" Label="Po rundzie (s)" Min="0" Max="3600" HideSpinButtons="true" />
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   Disabled="@(_supersetExerciseIds.Count < 2 || _savingSuperset)"
                                   OnClick="SaveSuperset">
                            @(_savingSuperset ? "Łączę…" : $"Utwórz superserię ({_supersetExerciseIds.Count})")
                        </MudButton>
                    </section>
                }

                <div class="exercise-timer-actions">
                    <button type="button" @onclick="() => StartRestTimer(exercise.RestSeconds ?? 90)"><MudIcon Icon="@Icons.Material.Outlined.Timer" /><span>Przerwa</span><strong>@FormatTime(exercise.RestSeconds ?? 90)</strong></button>
                    <button type="button" @onclick="StartInterval"><MudIcon Icon="@Icons.Material.Outlined.Timelapse" /><span>Interwał</span><strong>stoper</strong></button>
                </div>

                @if (SupersetMembers.Count > 1)
                {
                    <section class="workout-superset-strip" aria-label="Kolejność superserii">
                        <header><span>Superseria</span><strong>@SupersetRound z @SupersetRounds rund</strong></header>
                        <div>
                            @foreach (var member in SupersetMembers)
                            {
                                var memberIndex = OrderedExercises.ToList().FindIndex(x => x.Id == member.Id);
                                <button type="button" class="@(member.Id == exercise.Id ? "active" : null)" aria-current="@(member.Id == exercise.Id ? "step" : null)" @onclick="() => SelectExercise(memberIndex)">
                                    <span>A@(member.SupersetPosition)</span>
                                    <strong>@member.ExerciseName</strong>
                                    <small>@member.Sets.Count/@member.PlannedSets serii</small>
                                </button>
                            }
                        </div>
                    </section>
                }

                @if (exercise.ExerciseId is Guid exerciseId && _history.TryGetValue(exerciseId, out var last) && last is not null)
                {
                    <div class="last-performance"><span>Ostatnio</span><strong>@last.WeightKg kg × @last.Repetitions</strong><small>RIR @(last.Rir?.ToString("0.#") ?? "brak")</small></div>
                    @if (last.Repetitions >= exercise.MaxReps)
                    {
                        <div class="progression-tip"><MudIcon Icon="@Icons.Material.Outlined.TrendingUp" /><span>Górny zakres osiągnięty. Jeśli technika była pewna, spróbuj <strong>@SuggestedWeight(last.WeightKg) kg</strong>.</span></div>
                    }
                }

                <div class="workout-set-table" role="table" aria-label="Serie ćwiczenia">
                    <div class="workout-set-header" role="row">
                        <span>Seria</span><span>kg</span><span>Powt.</span><span>RIR</span><span>Stan</span>
                    </div>
                    @foreach (var set in exercise.Sets.OrderBy(x => x.SetNumber))
                    {
                        <button type="button"
                                class="workout-set-row saved"
                                @onclick="() => EditSet(exercise, set)"
                                role="row"
                                aria-label="@($"Edytuj serię {set.SetNumber}: {set.WeightKg} kg, {set.Repetitions} powtórzeń")">
                            <span class="set-number">@set.SetNumber@(set.SetType == SetType.Warmup ? "R" : null)</span>
                            <strong>@set.WeightKg</strong>
                            <strong>@set.Repetitions</strong>
                            <span>@(set.Rir?.ToString("0.#") ?? "-")</span>
                            <span class="set-status"><MudIcon Icon="@Icons.Material.Filled.Check" /></span>
                        </button>
                    }
                    <div class="workout-set-row active @(form.ValidationError is null ? null : "invalid")"
                         role="row"
                         aria-invalid="@(form.ValidationError is null ? "false" : "true")">
                        <span class="set-number">@(form.SetNumber ?? exercise.Sets.Count + 1)</span>
                        <MudNumericField @bind-Value="form.WeightKg"
                                         aria-label="Ciężar w kilogramach"
                                         Min="0m"
                                         Max="1000m"
                                         HideSpinButtons="true" />
                        <MudNumericField @bind-Value="form.Repetitions"
                                         aria-label="Liczba powtórzeń"
                                         Min="1"
                                         Max="1000"
                                         HideSpinButtons="true" />
                        <MudNumericField @bind-Value="form.Rir"
                                         aria-label="Powtórzenia w zapasie"
                                         Min="0m"
                                         Max="10m"
                                         HideSpinButtons="true" />
                        <span class="set-status current"><MudIcon Icon="@Icons.Material.Outlined.Edit" /></span>
                    </div>
                    @if (form.ValidationError is not null)
                    {
                        <p class="set-validation-error" role="alert">@form.ValidationError</p>
                    }
                    @{
                        var firstPlannedSet = Math.Max(exercise.Sets.Count + 2, 2);
                    }
                    @for (var plannedSet = firstPlannedSet; plannedSet <= exercise.PlannedSets; plannedSet++)
                    {
                        var preset = exercise.Presets?.FirstOrDefault(x => x.SetNumber == plannedSet);
                        <div class="workout-set-row planned" role="row" aria-label="@($"Zaplanowana seria {plannedSet}")">
                            <span class="set-number">@plannedSet</span>
                            <span>@(preset?.WeightKg.ToString("0.#") ?? "-")</span>
                            <span>@(preset?.Repetitions.ToString() ?? $"{exercise.MinReps}-{exercise.MaxReps}")</span>
                            <span>@(preset?.Rir?.ToString("0.#") ?? exercise.TargetRir?.ToString("0.#") ?? "-")</span>
                            <span class="set-status"></span>
                        </div>
                    }
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_savingSet"
                           OnClick="() => SaveSet(exercise, form)"
                           Class="workout-primary-action log-set-button">
                    @(_savingSet ? "Zapisuję…" : form.SetId is null ? "Zapisz serię" : "Zapisz poprawioną serię")
                </MudButton>

                <details class="set-details">
                    <summary>Notatka i typ serii</summary>
                    <MudTextField @bind-Value="form.Notes" Label="Notatka do serii" MaxLength="300" />
                    <MudCheckBox @bind-Value="form.IsWarmup" Label="Seria rozgrzewkowa" />
                </details>

                <div class="exercise-page-actions">
                    <MudButton Variant="Variant.Outlined" Disabled="@(_activeExerciseIndex == 0)" OnClick="PreviousExercise">Poprzednie</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_activeExerciseIndex >= OrderedExercises.Count - 1)" OnClick="NextExercise">Następne ćwiczenie</MudButton>
                </div>

                <details class="workout-options">
                    <summary>Opcje ćwiczenia i sesji</summary>
                    <MudSelect T="Guid?" @bind-Value="_selectedExerciseId" Label="Dodaj inne ćwiczenie">
                        @foreach (var option in _catalog) { <MudSelectItem T="Guid?" Value="@((Guid?)option.Id)">@option.Name</MudSelectItem> }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" FullWidth="true" Disabled="@(_selectedExerciseId is null)" OnClick="AddExercise">Dodaj do sesji</MudButton>
                    <MudTextField @bind-Value="_sessionNotes" Label="Notatka do treningu" Lines="3" MaxLength="1000" />
                    <MudButton Variant="Variant.Text" FullWidth="true" OnClick="SaveNotes">Zapisz notatkę</MudButton>
                </details>
            </article>

            <div class="session-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="Complete">Zakończ i zobacz podsumowanie</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="Abandon">Porzuć trening</MudButton>
            </div>
        }
        else if (_session.CardioEntries is { Count: > 0 })
        {
            <section class="cardio-only-workout">
                <MudIcon Icon="@Icons.Material.Outlined.DirectionsRun" />
                <div><span class="page-kicker">Cardio gotowe do zapisania</span><h2>@_session.Name</h2><p>Sprawdź rozpoznany czas i zakończ sesję, aby zapisać ją w historii.</p></div>
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="Complete">Zakończ trening cardio</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" OnClick="Abandon">Porzuć trening</MudButton>
            </section>
        }
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private WorkoutSessionResponse? _session;
    private readonly Dictionary<Guid, SetForm> _forms = [];
    private readonly Dictionary<Guid, ExerciseHistoryEntry?> _history = [];
    private IReadOnlyList<ExerciseResponse> _catalog = [];
    private readonly List<string> _newRecords = [];
    private IReadOnlyList<ExerciseProgressionResponse> _progressions = [];
    private Guid? _swapTargetId;
    private Guid? _selectedExerciseId;
    private string _swapSearch = string.Empty;
    private MuscleGroup? _swapMuscleGroup;
    private Equipment? _swapEquipment;
    private bool _swapSimilarOnly;
    private bool _swapping;
    private bool _savingSet;
    private bool _supersetBuilderOpen;
    private bool _savingSuperset;
    private readonly List<Guid> _supersetExerciseIds = [];
    private int _supersetRounds = 3;
    private int _supersetIntervalSeconds = 15;
    private int _supersetRestSeconds = 90;
    private string? _sessionNotes;
    private bool _completed;
    private int _activeExerciseIndex;
    private CancellationTokenSource? _clockCancellation;
    private TimerMode _timerMode;
    private int _timerSeconds;
    private int _timerStartSeconds;
    private bool _timerRunning;
    private TimeSpan _elapsed;
    private decimal _trainingCalories;

    private IReadOnlyList<WorkoutExerciseResponse> OrderedExercises => _session?.Exercises.OrderBy(x => x.Order).ToList() ?? [];
    private IReadOnlyList<ExerciseResponse> SwapOptions
    {
        get
        {
            var used = _session?.Exercises.Where(x => x.ExerciseId is not null).Select(x => x.ExerciseId!.Value).ToHashSet() ?? [];
            var activeMedia = ActiveExerciseMedia;
            return _catalog
                .Where(x => !used.Contains(x.Id))
                .Where(x => string.IsNullOrWhiteSpace(_swapSearch) || x.Name.Contains(_swapSearch.Trim(), StringComparison.OrdinalIgnoreCase))
                .Where(x => _swapMuscleGroup is null || x.MuscleGroup == _swapMuscleGroup)
                .Where(x => _swapEquipment is null || x.Equipment == _swapEquipment)
                .Where(x => !_swapSimilarOnly || activeMedia is null ||
                            x.MuscleGroup == activeMedia.MuscleGroup ||
                            x.Equipment == activeMedia.Equipment)
                .OrderBy(x => x.Name)
                .Take(12)
                .ToList();
        }
    }
    private WorkoutExerciseResponse? ActiveExercise => OrderedExercises.ElementAtOrDefault(_activeExerciseIndex);
    private ExerciseResponse? ActiveExerciseMedia =>
        ActiveExercise?.ExerciseId is Guid exerciseId ? _catalog.FirstOrDefault(x => x.Id == exerciseId) : null;
    private IReadOnlyList<WorkoutExerciseResponse> SupersetMembers =>
        ActiveExercise?.SupersetGroupId is Guid groupId
            ? OrderedExercises.Where(x => x.SupersetGroupId == groupId).OrderBy(x => x.SupersetPosition).ToList()
            : [];
    private int SupersetRounds => SupersetMembers.Count == 0 ? 0 : SupersetMembers.Max(x => x.PlannedSets);
    private int SupersetRound => SupersetMembers.Count == 0
        ? 0
        : Math.Min(SupersetRounds, SupersetMembers.Min(x => x.Sets.Count) + 1);
    private int MinimumSupersetRounds => Math.Max(
        1,
        OrderedExercises
            .Where(x => _supersetExerciseIds.Contains(x.Id))
            .Select(x => x.Sets.Count(set => set.SetType == SetType.Working))
            .DefaultIfEmpty(1)
            .Max());
    private int CompletedSets => _session?.Exercises.Sum(x => x.Sets.Count) ?? 0;
    private int PlannedSets => _session?.Exercises.Sum(x => x.PlannedSets) ?? 0;
    private int WorkingSets => _session?.Exercises.SelectMany(x => x.Sets).Count(x => x.SetType == SetType.Working) ?? 0;
    private int TotalRepetitions => _session?.Exercises.SelectMany(x => x.Sets).Sum(x => x.Repetitions) ?? 0;
    private int SessionPercent => PlannedSets == 0 ? 0 : Math.Min(100, (int)Math.Round(CompletedSets * 100d / PlannedSets));
    private decimal SessionVolume => _session?.Exercises.SelectMany(x => x.Sets).Where(x => x.SetType == SetType.Working).Sum(x => x.WeightKg * x.Repetitions) ?? 0;
    private string TimerLabel => _timerMode == TimerMode.Rest ? "Przerwa między seriami" : "Interwał";
    private string CompletionCopy => SessionPercent >= 100 ? "Wykonałeś cały plan sesji." : $"Wykonałeś {CompletedSets} z {PlannedSets} zaplanowanych serii.";

    protected override async Task OnParametersSetAsync()
    {
        await Reload();
        _completed = _session!.Status == SessionStatus.Completed;
        if (_completed)
        {
            _progressions = await TrainingApi.GetProgressions(Id);
            await LoadTrainingCalories();
        }
        _elapsed = (_session.FinishedAtUtc ?? DateTime.UtcNow) - _session.StartedAtUtc;
        _catalog = await TrainingApi.GetExercises();

        foreach (var exercise in _session.Exercises)
        {
            _forms.TryAdd(exercise.Id, new SetForm());
            var presetApplied = exercise.Sets.Count == 0 && ApplyNextPreset(exercise, _forms[exercise.Id]);
            if (exercise.ExerciseId is Guid exerciseId && !_history.ContainsKey(exerciseId))
            {
                _history[exerciseId] = (await TrainingApi.GetHistory(exerciseId)).FirstOrDefault();
                if (_history[exerciseId] is { } last && exercise.Sets.Count == 0 && !presetApplied)
                {
                    _forms[exercise.Id].WeightKg = last.WeightKg;
                    _forms[exercise.Id].Repetitions = last.Repetitions;
                    _forms[exercise.Id].Rir = last.Rir;
                }
            }
        }

        _activeExerciseIndex = Math.Clamp(_activeExerciseIndex, 0, Math.Max(0, OrderedExercises.Count - 1));
        if (!_completed && _clockCancellation is null)
        {
            _clockCancellation = new CancellationTokenSource();
            _ = RunClock(_clockCancellation.Token);
        }
    }

    private async Task SaveSet(WorkoutExerciseResponse exercise, SetForm form)
    {
        if (_savingSet)
            return;
        form.ValidationError = ValidateSet(form);
        if (form.ValidationError is not null)
            return;

        _savingSet = true;
        try
        {
            await JS.InvokeVoidAsync("formaTimer.ready");
            var setNumber = form.SetNumber ?? (exercise.Sets.Count == 0 ? 1 : exercise.Sets.Max(x => x.SetNumber) + 1);
            var request = new SaveSetRequest(exercise.Id, setNumber, form.WeightKg, form.Repetitions, form.Rir, form.IsWarmup ? SetType.Warmup : SetType.Working, form.Notes);
            if (form.SetId is Guid setId) await TrainingApi.UpdateSet(Id, setId, request); else await TrainingApi.SaveSet(Id, request);

            if (!form.IsWarmup && exercise.ExerciseId is Guid exerciseId && (!_history.TryGetValue(exerciseId, out var last) || last is null || form.WeightKg > last.WeightKg))
                if (!_newRecords.Contains(exercise.ExerciseName)) _newRecords.Add(exercise.ExerciseName);

            await Reload();
            form.SetId = null;
            form.SetNumber = null;
            form.Notes = null;
            form.IsWarmup = false;
            form.ValidationError = null;
            var refreshedExercise = OrderedExercises.First(x => x.Id == exercise.Id);
            ApplyNextPreset(refreshedExercise, form);
            if (request.SetType != SetType.Warmup)
            {
                var step = WorkoutSequence.Next(
                    OrderedExercises.Select(x => new WorkoutExerciseState(
                        x.Id,
                        x.Order,
                        x.PlannedSets,
                        x.Sets.Count,
                        x.SupersetGroupId,
                        x.SupersetPosition,
                        x.IntervalSeconds,
                        x.RestSeconds)).ToList(),
                    exercise.Id);
                if (step.NextExerciseId is Guid nextId)
                {
                    var nextIndex = OrderedExercises.ToList().FindIndex(x => x.Id == nextId);
                    if (nextIndex >= 0)
                        SelectExercise(nextIndex);
                }
                if (step.Timer == WorkoutTimerKind.Interval)
                    StartIntervalCountdown(step.Seconds);
                else if (step.Timer == WorkoutTimerKind.Rest)
                    StartRestTimer(step.Seconds);
                else
                    CloseTimer();
            }
        }
        catch (HttpRequestException)
        {
            form.ValidationError = "Nie udało się zapisać serii. Sprawdź połączenie i spróbuj ponownie.";
            Snackbar.Add("Nie udało się zapisać serii.", Severity.Error);
        }
        finally
        {
            _savingSet = false;
        }
    }

    private void EditSet(WorkoutExerciseResponse exercise, CompletedSetResponse set)
    {
        var form = _forms[exercise.Id];
        form.SetId = set.Id;
        form.SetNumber = set.SetNumber;
        form.WeightKg = set.WeightKg;
        form.Repetitions = set.Repetitions;
        form.Rir = set.Rir;
        form.IsWarmup = set.SetType == SetType.Warmup;
        form.Notes = set.Notes;
        form.ValidationError = null;
    }

    private static bool ApplyNextPreset(WorkoutExerciseResponse exercise, SetForm form)
    {
        var nextNumber = exercise.Sets.Count(x => x.SetType == SetType.Working) + 1;
        var preset = exercise.Presets?.FirstOrDefault(x => x.SetNumber == nextNumber);
        if (preset is null) return false;
        form.WeightKg = preset.WeightKg;
        form.Repetitions = preset.Repetitions;
        form.Rir = preset.Rir;
        return true;
    }

    private void SelectExercise(int index) => _activeExerciseIndex = Math.Clamp(index, 0, Math.Max(0, OrderedExercises.Count - 1));
    private void PreviousExercise() => SelectExercise(_activeExerciseIndex - 1);
    private void NextExercise() => SelectExercise(_activeExerciseIndex + 1);
    private void BeginSwap(WorkoutExerciseResponse exercise)
    {
        _swapTargetId = exercise.Id;
        _selectedExerciseId = null;
        _swapSearch = string.Empty;
        var current = exercise.ExerciseId is Guid exerciseId
            ? _catalog.FirstOrDefault(x => x.Id == exerciseId)
            : null;
        _swapMuscleGroup = current?.MuscleGroup;
        _swapEquipment = current?.Equipment;
        _swapSimilarOnly = true;
    }
    private void CancelSwap()
    {
        _swapTargetId = null;
        _selectedExerciseId = null;
        _swapSearch = string.Empty;
        _swapMuscleGroup = null;
        _swapEquipment = null;
        _swapSimilarOnly = false;
    }

    private void HandleSwapKeyDown(KeyboardEventArgs keyboardEvent)
    {
        if (keyboardEvent.Key == "Escape")
            CancelSwap();
    }

    private async Task ReplaceExercise(WorkoutExerciseResponse exercise)
    {
        if (_selectedExerciseId is null) return;
        _swapping = true;
        try
        {
            var replacement = await TrainingApi.ReplaceExercise(Id, exercise.Id, _selectedExerciseId.Value);
            await Reload();
            _forms.TryAdd(replacement.Id, new SetForm());
            if (replacement.ExerciseId is Guid replacementExerciseId && !_history.ContainsKey(replacementExerciseId))
                _history[replacementExerciseId] = (await TrainingApi.GetHistory(replacementExerciseId)).FirstOrDefault();
            _activeExerciseIndex = OrderedExercises.ToList().FindIndex(x => x.Id == replacement.Id);
            Snackbar.Add(exercise.Sets.Count == 0 ? "Ćwiczenie zostało zamienione." : "Wykonane serie zostały zachowane, a zamiennik dodany jako następne ćwiczenie.", Severity.Success);
            CancelSwap();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Nie udało się zamienić ćwiczenia.", Severity.Error);
        }
        finally
        {
            _swapping = false;
        }
    }

    private void BeginSuperset(WorkoutExerciseResponse exercise)
    {
        _supersetExerciseIds.Clear();
        if (exercise.SupersetGroupId is Guid groupId)
        {
            foreach (var member in OrderedExercises.Where(x => x.SupersetGroupId == groupId).OrderBy(x => x.SupersetPosition))
                _supersetExerciseIds.Add(member.Id);
            _supersetRounds = OrderedExercises
                .Where(x => x.SupersetGroupId == groupId)
                .Max(x => x.PlannedSets);
            _supersetIntervalSeconds = exercise.IntervalSeconds ?? 15;
            _supersetRestSeconds = exercise.RestSeconds ?? 90;
        }
        else
        {
            _supersetExerciseIds.Add(exercise.Id);
            _supersetRounds = Math.Max(exercise.PlannedSets, MinimumSupersetRounds);
        }
        _supersetBuilderOpen = true;
        CancelSwap();
    }

    private void ToggleSupersetExercise(Guid exerciseId)
    {
        if (!_supersetExerciseIds.Remove(exerciseId) && _supersetExerciseIds.Count < 5)
            _supersetExerciseIds.Add(exerciseId);
        _supersetRounds = Math.Max(_supersetRounds, MinimumSupersetRounds);
    }

    private void MoveSupersetExercise(Guid exerciseId, int offset)
    {
        var currentIndex = _supersetExerciseIds.IndexOf(exerciseId);
        var targetIndex = currentIndex + offset;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= _supersetExerciseIds.Count)
            return;
        _supersetExerciseIds.RemoveAt(currentIndex);
        _supersetExerciseIds.Insert(targetIndex, exerciseId);
    }

    private void CancelSuperset()
    {
        _supersetBuilderOpen = false;
        _supersetExerciseIds.Clear();
    }

    private async Task SaveSuperset()
    {
        if (_supersetExerciseIds.Count < 2 || _savingSuperset) return;
        _savingSuperset = true;
        try
        {
            _session = await TrainingApi.UpdateSuperset(
                Id,
                new UpdateWorkoutSupersetRequest(
                    _supersetExerciseIds.ToList(),
                    _supersetRounds,
                    _supersetIntervalSeconds,
                    _supersetRestSeconds));
            CancelSuperset();
            Snackbar.Add("Superseria została zapisana.", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingSuperset = false;
        }
    }

    private async Task AddExercise()
    {
        if (_selectedExerciseId is null) return;
        await TrainingApi.AddExercise(Id, new AddWorkoutExerciseRequest(_selectedExerciseId.Value));
        _selectedExerciseId = null;
        await Reload();
        foreach (var item in _session!.Exercises) _forms.TryAdd(item.Id, new SetForm());
        _activeExerciseIndex = OrderedExercises.Count - 1;
    }

    private async Task SaveNotes()
    {
        await TrainingApi.SaveNotes(Id, _sessionNotes);
        Snackbar.Add("Notatka zapisana.", Severity.Success);
    }

    private async Task Reload() => _session = await TrainingApi.GetSession(Id);

    private void StartRestTimer(int seconds)
    {
        _timerMode = TimerMode.Rest;
        _timerStartSeconds = Math.Max(1, seconds);
        _timerSeconds = _timerStartSeconds;
        _timerRunning = true;
    }

    private void StartInterval()
    {
        _timerMode = TimerMode.Interval;
        _timerStartSeconds = 0;
        _timerSeconds = 0;
        _timerRunning = true;
    }
    private void StartIntervalCountdown(int seconds)
    {
        _timerMode = TimerMode.Interval;
        _timerStartSeconds = Math.Max(0, seconds);
        _timerSeconds = _timerStartSeconds;
        _timerRunning = _timerSeconds > 0;
    }

    private void ToggleTimer() => _timerRunning = !_timerRunning;
    private void ResetTimer() { _timerSeconds = _timerStartSeconds; _timerRunning = true; }
    private void CloseTimer() { _timerMode = TimerMode.None; _timerRunning = false; _timerSeconds = 0; }

    private async Task RunClock(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _elapsed = DateTime.UtcNow - _session!.StartedAtUtc;
                if (_timerRunning && _timerMode == TimerMode.Rest && _timerSeconds > 0)
                {
                    if (--_timerSeconds == 0)
                    {
                        _timerRunning = false;
                        await JS.InvokeVoidAsync("formaTimer.done");
                    }
                }
                else if (_timerRunning && _timerMode == TimerMode.Interval && _timerStartSeconds > 0 && _timerSeconds > 0)
                {
                    if (--_timerSeconds == 0)
                    {
                        _timerRunning = false;
                        await JS.InvokeVoidAsync("formaTimer.done");
                    }
                }
                else if (_timerRunning && _timerMode == TimerMode.Interval)
                {
                    _timerSeconds++;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task Complete()
    {
        await TrainingApi.Complete(Id);
        _clockCancellation?.Cancel();
        _completed = true;
        _timerRunning = false;
        _progressions = await TrainingApi.GetProgressions(Id);
        await LoadTrainingCalories();
    }

    private async Task Decide(ExerciseProgressionResponse item, ProgressionDecision decision)
    {
        await TrainingApi.DecideProgression(item.Id, new(decision, decision == ProgressionDecision.Accepted ? item.SuggestedWeightKg : null));
        _progressions = await TrainingApi.GetProgressions(Id);
    }

    private static string DecisionName(ProgressionDecision decision) => decision switch
    {
        ProgressionDecision.Accepted => "Przyjęto",
        ProgressionDecision.Changed => "Bez zmiany",
        ProgressionDecision.Rejected => "Odrzucono",
        _ => "Oczekuje"
    };

    private async Task Abandon()
    {
        await TrainingApi.Abandon(Id);
        Navigation.NavigateTo("/training");
    }

    private static decimal ExerciseVolume(WorkoutExerciseResponse exercise) => exercise.Sets.Where(x => x.SetType == SetType.Working).Sum(x => x.WeightKg * x.Repetitions);
    private static decimal BestEstimatedOneRepMax(WorkoutExerciseResponse exercise) => exercise.Sets.Where(x => x.SetType == SetType.Working).Select(x => x.WeightKg * (1 + x.Repetitions / 30m)).DefaultIfEmpty().Max();
    private static string FormatTime(int seconds) => $"{seconds / 60:00}:{seconds % 60:00}";
    private static string FormatElapsed(TimeSpan elapsed) => $"{(int)elapsed.TotalHours:00}:{elapsed.Minutes:00}:{elapsed.Seconds:00}";
    private static decimal SuggestedWeight(decimal weight) => Math.Ceiling((weight + (weight < 30 ? 1.25m : 2.5m)) * 4m) / 4m;
    private static string? ValidateSet(SetForm form)
    {
        if (form.WeightKg is < 0 or > 1000)
            return "Ciężar musi mieścić się w zakresie 0-1000 kg.";
        if (form.Repetitions is < 1 or > 1000)
            return "Liczba powtórzeń musi mieścić się w zakresie 1-1000.";
        if (form.Rir is < 0 or > 10)
            return "RIR musi mieścić się w zakresie 0-10.";
        return null;
    }
    private static string SwapExplanation(WorkoutExerciseResponse exercise)
    {
        if (exercise.Sets.Count == 0) return "Nowe ćwiczenie przejmie serie, zakres powtórzeń, RIR i przerwę.";
        var remaining = Math.Max(1, exercise.PlannedSets - exercise.Sets.Count);
        return $"Zamiennik pojawi się jako następne ćwiczenie z liczbą serii: {remaining}.";
    }
    private static string EquipmentName(Equipment equipment) => equipment switch { Equipment.Barbell => "Sztanga", Equipment.Dumbbell => "Hantle", Equipment.Machine => "Maszyna", Equipment.Cable => "Wyciąg", Equipment.Bodyweight => "Masa ciała", Equipment.Kettlebell => "Kettlebell", _ => "Inny sprzęt" };
    private static string MuscleGroupName(MuscleGroup group) => group switch { MuscleGroup.Chest => "Klatka piersiowa", MuscleGroup.Back => "Plecy", MuscleGroup.Shoulders => "Barki", MuscleGroup.Biceps => "Biceps", MuscleGroup.Triceps => "Triceps", MuscleGroup.Quadriceps => "Czworogłowe uda", MuscleGroup.Hamstrings => "Dwugłowe uda", MuscleGroup.Glutes => "Pośladki", MuscleGroup.Calves => "Łydki", MuscleGroup.Core => "Core", MuscleGroup.Forearms => "Przedramiona", _ => "Całe ciało" };

    private async Task LoadTrainingCalories()
    {
        var completedAt = (_session!.FinishedAtUtc ?? DateTime.UtcNow).ToLocalTime();
        var day = await NutritionApi.GetDay(DateOnly.FromDateTime(completedAt));
        _trainingCalories = day.TrainingBonusCalories;
    }

    public ValueTask DisposeAsync()
    {
        _clockCancellation?.Cancel();
        _clockCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

    private enum TimerMode { None, Rest, Interval }

    private sealed class SetForm
    {
        public decimal WeightKg { get; set; }
        public int Repetitions { get; set; } = 8;
        public decimal? Rir { get; set; } = 2;
        public bool IsWarmup { get; set; }
        public Guid? SetId { get; set; }
        public int? SetNumber { get; set; }
        public string? Notes { get; set; }
        public string? ValidationError { get; set; }
    }
}
